generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  name                String?
  email               String            @unique
  passwordHash        String?
  image               String?
  trackingPreferences String?
  mediaItems          UserMedia[]
  collections         Collection[]
  sessions            ActivitySession[]
  activityEvents      ActivityEvent[]
  createdAt           DateTime          @default(now())
}

model UserMedia {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Media identification
  mediaType       String          // "movie" | "tv" | "anime" | "manga" | "game" | "novel"
  externalId      String?
  externalSource  String?         // Active: "kitsu", "tmdb", "steam", "itunes", "tvmaze", "openlibrary", "manual". Legacy stored: "jikan"
  title           String
  posterUrl       String?
  year            Int?
  genres          String?         // JSON string array
  overview        String?

  // Tracking
  status          String          @default("plan_to_consume") // plan_to_consume, in_progress, completed, dropped, on_hold
  rating          Float?          // 0-10
  review          String?
  isFavorite      Boolean         @default(false)

  // Progress
  totalEpisodes   Int?
  watchedEpisodes Int?
  totalChapters   Int?
  readChapters    Int?
  hoursPlayed     Float?

  // Dates & Tags
  startDate       DateTime?
  endDate         DateTime?
  tags            String?         // JSON string array
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  collectionItems CollectionItem[]
  sources         MediaSource[]
  sessions        ActivitySession[]
  activityEvents  ActivityEvent[]

  @@unique([userId, mediaType, externalId])
  @@unique([id, userId])
  @@index([userId, mediaType])
  @@index([userId, status])
}

model MediaSource {
  id               String            @id @default(cuid())
  userMediaId      String
  userMedia        UserMedia         @relation(fields: [userMediaId], references: [id], onDelete: Cascade)
  name             String
  url              String
  normalizedDomain String
  sourceType       String            @default("web") // "stream", "reader", "game", "store", "web"
  sessions         ActivitySession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userMediaId])
  @@index([normalizedDomain])
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
}

model CollectionItem {
  id            String     @id @default(cuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userMediaId   String
  userMedia     UserMedia  @relation(fields: [userMediaId], references: [id], onDelete: Cascade)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([collectionId, userMediaId])
}

model ActivitySession {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMediaId        String
  userMedia          UserMedia       @relation(fields: [userMediaId, userId], references: [id, userId], onDelete: Cascade)
  sourceId           String?
  source             MediaSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  startedAt          DateTime
  endedAt            DateTime?
  lastHeartbeatAt    DateTime?
  activeSeconds      Int             @default(0)
  lastSequenceNumber Int             @default(0)
  lastClientNonce    String?
  sourceType         String          @default("web") // "web" | "desktop" | "manual" | "extension"
  isManual           Boolean         @default(false)
  status             String          @default("active") // "active" | "paused" | "completed" | "recovered" | "abandoned"
  closeReason        String?
  notes              String?
  progressStart      Int?
  progressEnd        Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  events             ActivityEvent[]

  @@unique([id, userId, userMediaId])
  @@index([userId, userMediaId])
  @@index([userId, startedAt])
  @@index([userMediaId])
  @@index([status])
}

model ActivityEvent {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String?
  session         ActivitySession? @relation(fields: [sessionId, userId, userMediaId], references: [id, userId, userMediaId], onDelete: Cascade)
  userMediaId     String
  userMedia       UserMedia        @relation(fields: [userMediaId, userId], references: [id, userId], onDelete: Cascade)
  clientNonce     String
  eventType       String           @default("HEARTBEAT")
  sequenceNumber  Int?
  durationSeconds Int              @default(15)
  isFocused       Boolean          @default(true)
  timestamp       DateTime
  createdAt       DateTime         @default(now())

  @@unique([userId, clientNonce])
  @@index([userId, userMediaId])
  @@index([sessionId])
  @@index([timestamp])
}
